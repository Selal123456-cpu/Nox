        addKDStroke(row, 1)

        local lbl = Instance.new("TextLabel")
        lbl.Size = UDim2.new(0.52,0,1,0)
        lbl.Position = UDim2.new(0,12,0,0)
        lbl.BackgroundTransparency = 1
        lbl.Text = label
        lbl.TextColor3 = Color3.fromRGB(255,255,255)
        lbl.TextSize = 12
        lbl.Font = Enum.Font.GothamBold
        lbl.TextXAlignment = Enum.TextXAlignment.Left
        lbl.Parent = row

        local keyBtn = Instance.new("TextButton")
        keyBtn.Size = UDim2.new(0,78,0,24)
        keyBtn.Position = UDim2.new(1,-88,0.5,-12)
        keyBtn.BackgroundColor3 = Color3.fromRGB(50,50,50)
        keyBtn.BorderSizePixel = 0
        keyBtn.TextColor3 = Color3.fromRGB(255,255,255)
        keyBtn.TextSize = 10
        keyBtn.Font = Enum.Font.GothamBold
        keyBtn.Text = getBind(key) ~= "" and getBind(key) or "NONE"
        keyBtn.Parent = row
        if type(addCorner) == "function" then addCorner(keyBtn, 5) end
        addKDStroke(keyBtn, 1)

        local clear = Instance.new("TextButton")
        clear.Size = UDim2.new(0,22,0,24)
        clear.Position = UDim2.new(1,-26,0.5,-12)
        clear.BackgroundColor3 = Color3.fromRGB(80,80,80)
        clear.BorderSizePixel = 0
        clear.Text = "X"
        clear.TextColor3 = Color3.fromRGB(255,255,255)
        clear.TextSize = 10
        clear.Font = Enum.Font.GothamBold
        clear.Parent = row
        if type(addCorner) == "function" then addCorner(clear, 5) end

        local listening = false
        local conn

        local function stopListen()
            listening = false
            if conn then
                pcall(function() conn:Disconnect() end)
                conn = nil
            end
            keyBtn.BackgroundColor3 = Color3.fromRGB(50,50,50)
            local b = getBind(key)
            keyBtn.Text = b ~= "" and b or "NONE"
        end

        keyBtn.MouseButton1Click:Connect(function()
            if listening then
                stopListen()
                return
            end

            listening = true
            keyBtn.Text = "PRESS KEY"
            keyBtn.BackgroundColor3 = Color3.fromRGB(100,100,100)

            if conn then pcall(function() conn:Disconnect() end) end
            conn = UIS_KD.InputBegan:Connect(function(input)
                if not listening then return end

                if input.UserInputType == Enum.UserInputType.Keyboard
                    or string.find(input.UserInputType.Name, "Gamepad") then

                    local name = input.KeyCode.Name
                    if name ~= "Unknown" then
                        setBind(key, name)
                        keyBtn.Text = name
                        stopListen()
                    end
                end
            end)
        end)

        clear.MouseButton1Click:Connect(function()
            stopListen()
            setBind(key, "")
            keyBtn.Text = "NONE"
        end)

        if type(hoverRow) == "function" then
            pcall(hoverRow, row, ROW_ALPHA or 0.96)
        end

        return row
    end

    -- Add the keybind panel after the existing MAIN controls.
    local kdParent = tabPages and tabPages["MAIN"]
    if kdParent then
        local sectionOrder = 1000
        if type(sectionLabel) == "function" then
            sectionLabel(kdParent, "KEYBINDS", sectionOrder)
        end

        local order = sectionOrder + 1
        for key, label in pairs(featureNames) do
            makeKDRow(kdParent, key, label, order)
            order = order + 1
        end
    end

    -- Direct action/toggle dispatcher. This does not depend on _AMIRI.
    local function runKD(key)
        local ok = false

        -- Existing toggle registry.
        if type(_toggleRegistry) == "table" then
            for _, entry in ipairs(_toggleRegistry) do
                if entry and entry.key == key and type(entry.setState) == "function" then
                    local current = _configState[key] == true
                    pcall(entry.setState, not current)
                    _configState[key] = not current
                    if type(entry.callback) == "function" then
                        pcall(entry.callback, not current)
                    end
                    kdSave()
                    return true
                end
            end
        end

        -- Existing actions.
        local actions = {
            DROP = runDrop,
            TPDOWN = runTPFloor,
        }

        local fn = actions[key]
        if type(fn) == "function" then
            pcall(fn)
            ok = true
        end

        return ok
    end

    if KD.listener then
        pcall(function() KD.listener:Disconnect() end)
    end

    KD.listener = UIS_KD.InputBegan:Connect(function(input, gameProcessed)
        if gameProcessed then return end
        if input.UserInputType ~= Enum.UserInputType.Keyboard then return end

        local pressed = input.KeyCode.Name
        if pressed == "Unknown" then return end

        for key, bound in pairs(KD.binds) do
            if bound == pressed then
                runKD(key)
                break
            end
        end
    end)
end
