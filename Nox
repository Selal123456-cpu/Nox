local _AMAZON_ANIMS = {
    WalkAnim  = "rbxassetid://90478085024465",
    RunAnim   = "rbxassetid://134824450619865",
    JumpAnim  = "rbxassetid://121454505477205",
    FallAnim  = "rbxassetid://94788218468396",
    SwimIdle  = "rbxassetid://129126268464847",
    Swim      = "rbxassetid://105962919001086",
    ClimbAnim = "rbxassetid://121145883950231",
    Animation1 = "rbxassetid://98281136301627",
}
local _amazonAnimEnabled = false
local _amazonOrig = {}
local _amazonCharConn = nil

local function _amazonSetAnim(parent, name, animationId)
    if not parent or not animationId then return end
    local obj = parent:FindFirstChild(name)
    if not obj then
        obj = Instance.new("Animation")
        obj.Name = name
        obj.Parent = parent
    end
    obj.AnimationId = animationId
end

local function _applyAmazonAnim(char)
    if not char then return end
    local A = char:FindFirstChild("Animate")
    if not A then return end

    pcall(function()
        _amazonOrig.walk = A.walk.WalkAnim.AnimationId
        _amazonOrig.run = A.run.RunAnim.AnimationId
        _amazonOrig.jump = A.jump.JumpAnim.AnimationId
        _amazonOrig.climb = A.climb.ClimbAnim.AnimationId
        _amazonOrig.fall = A.fall.FallAnim.AnimationId
        if A.swim then
            _amazonOrig.swim = A.swim.Swim.AnimationId
        end
        if A.swimidle then
            _amazonOrig.swimIdle = A.swimidle.SwimIdle.AnimationId
        end

        _amazonSetAnim(A.walk, "WalkAnim", _AMAZON_ANIMS.WalkAnim)
        _amazonSetAnim(A.run, "RunAnim", _AMAZON_ANIMS.RunAnim)
        _amazonSetAnim(A.jump, "JumpAnim", _AMAZON_ANIMS.JumpAnim)
        _amazonSetAnim(A.climb, "ClimbAnim", _AMAZON_ANIMS.ClimbAnim)
        _amazonSetAnim(A.fall, "FallAnim", _AMAZON_ANIMS.FallAnim)
        if A.swim then _amazonSetAnim(A.swim, "Swim", _AMAZON_ANIMS.Swim) end
        if A.swimidle then _amazonSetAnim(A.swimidle, "SwimIdle", _AMAZON_ANIMS.SwimIdle) end
    end)

    pcall(function()
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then
            for _, track in ipairs(hum:GetPlayingAnimationTracks()) do
                track:Stop(0)
            end
            hum.Jump = true
        end
    end)
end

local function _restoreAmazonAnim(char)
    if not char or not next(_amazonOrig) then return end
    local A = char:FindFirstChild("Animate")
    if not A then return end

    pcall(function()
        if _amazonOrig.walk and A.walk and A.walk:FindFirstChild("WalkAnim") then A.walk.WalkAnim.AnimationId = _amazonOrig.walk end
        if _amazonOrig.run and A.run and A.run:FindFirstChild("RunAnim") then A.run.RunAnim.AnimationId = _amazonOrig.run end
        if _amazonOrig.jump and A.jump and A.jump:FindFirstChild("JumpAnim") then A.jump.JumpAnim.AnimationId = _amazonOrig.jump end
        if _amazonOrig.climb and A.climb and A.climb:FindFirstChild("ClimbAnim") then A.climb.ClimbAnim.AnimationId = _amazonOrig.climb end
        if _amazonOrig.fall and A.fall and A.fall:FindFirstChild("FallAnim") then A.fall.FallAnim.AnimationId = _amazonOrig.fall end
        if _amazonOrig.swim and A.swim and A.swim:FindFirstChild("Swim") then A.swim.Swim.AnimationId = _amazonOrig.swim end
        if _amazonOrig.swimIdle and A.swimidle and A.swimidle:FindFirstChild("SwimIdle") then A.swimidle.SwimIdle.AnimationId = _amazonOrig.swimIdle end
    end)
end

function _AK.enableAmazonUnboxed()
    _amazonAnimEnabled = true
    _amazonOrig = {}
    _applyAmazonAnim(LP.Character)
    if _amazonCharConn then _amazonCharConn:Disconnect() end
    _amazonCharConn = LP.CharacterAdded:Connect(function(char)
        task.wait(1)
        if _amazonAnimEnabled then
            _amazonOrig = {}
            _applyAmazonAnim(char)
        end
    end)
end

function _AK.disableAmazonUnboxed()
    _amazonAnimEnabled = false
    if _amazonCharConn then
        _amazonCharConn:Disconnect()
        _amazonCharConn = nil
    end
    _restoreAmazonAnim(LP.Character)
    _amazonOrig = {}
