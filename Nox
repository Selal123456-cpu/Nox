-- LIVE FPS / MS (network ping) for the STEAL bar.
-- Updates every 0.25s for a responsive live display.
do
    local _RS = game:GetService("RunService")
    local _Stats = game:GetService("Stats")
    local _fpsTime = 0
    local _fpsFrames = 0
    local _lastFPS = 0
    local _lastMS = 0

    _RS.RenderStepped:Connect(function(dt)
        _fpsTime = _fpsTime + dt
        _fpsFrames = _fpsFrames + 1

        if _fpsTime >= 0.25 then
            _lastFPS = math.floor((_fpsFrames / _fpsTime) + 0.5)
            _fpsFrames = 0
            _fpsTime = 0

            pcall(function()
                _lastMS = math.floor(_Stats.Network.ServerStatsItem["Data Ping"]:GetValue() + 0.5)
            end)

            if progressStatusLbl and progressStatusLbl.Parent then
                progressStatusLbl.Text = string.format("%d FPS | %dms", _lastFPS, _lastMS)
                progressStatusLbl.TextColor3 = Color3.fromRGB(255,255,255)
            end
        end
    end)
end

-- WHITE ROTATING LIGHT AROUND ALL PANEL BUTTONS + GUI BUTTON
do
    local glow = {}

    local function addGlow(obj, baseThick)
        if not obj or not obj:IsA("GuiObject") then return end

        local old = obj:FindFirstChild("WhiteRotatingGlow")
        if old then old:Destroy() end

        local stroke = Instance.new("UIStroke")
        stroke.Name = "WhiteRotatingGlow"
        stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
        stroke.LineJoinMode = Enum.LineJoinMode.Round
        stroke.Thickness = baseThick or 1.7
        stroke.Transparency = 0
        stroke.Color = Color3.fromRGB(255,255,255)
        stroke.Parent = obj

        local gradient = Instance.new("UIGradient")
        gradient.Color = ColorSequence.new(Color3.fromRGB(255,255,255))
        gradient.Rotation = 0
        gradient.Parent = stroke

        table.insert(glow, {
            stroke = stroke,
            grad = gradient,
            base = baseThick or 1.7
        })
    end

    -- LAHAT ng buttons sa loob ng panel
    if typeof(candyBtnRefs) == "table" then
        for key, val in pairs(candyBtnRefs) do
            if typeof(val) == "Instance"
            and val:IsA("GuiObject")
            and (
                type(key) ~= "string"
                or string.sub(key, -6) == "_frame"
                or val:IsA("TextButton")
                or val:IsA("ImageButton")
            ) then
                addGlow(val, 1.7)
            end
        end
    end

    -- Hanapin ang GUI BUTTON mismo.
    -- Kasama rito ang common names: GUIButton, GUI_BUTTON, Menu, Settings/X,
    -- Open, Toggle, Floating, at main button.
    local function scanForGuiButton(root)
        if not root then return end

        for _, obj in ipairs(root:GetDescendants()) do
            if obj:IsA("TextButton") or obj:IsA("ImageButton") then
                local n = string.lower(obj.Name)

                if n == "gui_button"
                or n == "guibutton"
                or n == "gui button"
                or n == "mainbutton"
                or n == "main_button"
                or n == "menubutton"
                or n == "menu_button"
                or n == "togglebutton"
                or n == "toggle_button"
                or n == "openbutton"
                or n == "open_button"
                or n == "floatingbutton"
                or n == "floating_button"
                or n == "settingsbutton"
                or n == "settings_button"
                or n == "xbutton"
                or n == "x_button"
                or string.find(n, "gui", 1, true)
                or string.find(n, "menu", 1, true)
                or string.find(n, "settings", 1, true) then
                    addGlow(obj, 2.0)
                end
            end
        end
    end

    -- I-scan ang buong GUI hierarchy kung saan nakalagay ang script.
    if script and script.Parent then
        local root = script.Parent
        while root.Parent and root.Parent:IsA("GuiObject") do
            root = root.Parent
        end
        scanForGuiButton(root)
    end

    -- White rotating light band
    local band = NumberSequence.new({
        NumberSequenceKeypoint.new(0.00, 0.85),
        NumberSequenceKeypoint.new(0.42, 0.85),
        NumberSequenceKeypoint.new(0.50, 0.00),
        NumberSequenceKeypoint.new(0.58, 0.85),
        NumberSequenceKeypoint.new(1.00, 0.85),
    })

    for _, e in ipairs(glow) do
        e.grad.Transparency = band
    end

    local t = 0

    RunService.RenderStepped:Connect(function(dt)
        t += dt

        local rotation = (t * 70) % 360
        local breathe = math.sin(t * 1.8) * 0.5 + 0.5

        for i = #glow, 1, -1 do
            local e = glow[i]

            if e.stroke and e.stroke.Parent and e.grad and e.grad.Parent then
                e.grad.Rotation = rotation
                e.stroke.Thickness =
                    e.base * (0.9 + breathe * 0.45)
            else
                table.remove(glow, i)
            end
        end
    end)
end

